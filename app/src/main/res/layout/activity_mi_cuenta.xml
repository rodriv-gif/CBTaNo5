<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F7F8"
    android:id="@+id/raiz">

    <!-- ENCABEZADO verde (tambien cubre la barra de estado) -->
    <LinearLayout
        android:id="@+id/encabezado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#004D32"
        android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp">

        <!-- BOTON REGRESAR -->
        <TextView
            android:id="@+id/btnRegresar"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="←"
            android:textSize="32sp"
            android:textColor="#FFFFFF"
            android:contentDescription="Regresar"
            android:clickable="true"
            android:focusable="true" />

        <!-- TITULO DE LA PANTALLA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="56dp"
            android:layout_marginEnd="56dp"
            android:gravity="center"
            android:text="Mi cuenta"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

    </FrameLayout>

    </LinearLayout>

    <!-- CONTENIDO DESPLAZABLE -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:overScrollMode="ifContentScrolls"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- TARJETA PERFIL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="85dp"
                android:orientation="vertical"
                android:padding="1dp"
                android:background="#B4DDBE">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="83dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:background="#E2F5E6">

                    <!-- IMAGEN PERFIL -->
                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center_vertical">

                        <ImageView
                            android:id="@+id/imgPerfil"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_myplaces"
                            android:contentDescription="Perfil del lector" />

                        <TextView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="bottom|end"
                            android:gravity="center"
                            android:text="✓"
                            android:textSize="12sp"
                            android:textColor="#00562F" />

                    </FrameLayout>

                    <!-- NOMBRE Y TIPO DE USUARIO -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <!-- NOMBRE COMPLETO -->
                        <TextView
                            android:id="@+id/txtNombrePerfil"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="23sp"
                            android:textStyle="bold"
                            android:textColor="#00562F"
                            android:breakStrategy="high_quality"
                            tools:text="Ana López Hernández" />

                        <!-- TIPO DE LECTOR -->
                        <TextView
                            android:id="@+id/txtTipoUsuario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="13sp"
                            android:textColor="#17212F"
                            tools:text="Alumno" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- TITULO DATOS DE LA CUENTA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="12dp"
                android:text="Datos de la cuenta"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#00562F" />

            <!-- RECUADRO DATOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#C4D3E0"
                android:padding="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="#FFFFFF">

                    <!-- ETIQUETA NOMBRE -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nombre"
                        android:textSize="12sp"
                        android:textColor="#475569" />

                    <!-- NOMBRE DEL LECTOR -->
                    <TextView
                        android:id="@+id/txtNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#111827"
                        android:breakStrategy="high_quality"
                        tools:text="Ana López Hernández" />

                    <!-- ETIQUETA CARRERA -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="Carrera"
                        android:textSize="12sp"
                        android:textColor="#475569" />

                    <!-- CARRERA DEL LECTOR -->
                    <TextView
                        android:id="@+id/txtCarrera"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#111827"
                        android:breakStrategy="high_quality"
                        tools:text="Tecnologías de la información" />

                </LinearLayout>

            </LinearLayout>

            <!-- TITULO MI ACTIVIDAD Y ACCESO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="12dp"
                android:text="Mi actividad y acceso"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#00562F" />

            <!-- CONTENEDOR DE OPCIONES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#C4D3E0"
                android:padding="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF">

                    <!-- OPCION MIS PRESTAMOS -->
                    <LinearLayout
                        android:id="@+id/opMisPrestamos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="60dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackground">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Mis préstamos"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:textColor="#111827" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Consulta tus libros y devoluciones"
                                android:textSize="12sp"
                                android:textColor="#475569" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="25dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="›"
                            android:textSize="26sp"
                            android:textColor="#00562F"
                            android:gravity="center" />

                    </LinearLayout>

                    <!-- OPCION MIS ADEUDOS -->
                    <LinearLayout
                        android:id="@+id/opMisAdeudos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="60dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackground">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Mis Adeudos"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#111827" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Revisa y administra tus adeudos"
                                android:textSize="12sp"
                                android:textColor="#475569" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="25dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="›"
                            android:textSize="26sp"
                            android:textColor="#00562F"
                            android:gravity="center" />

                    </LinearLayout>

                    <!-- OPCION CAMBIAR CONTRASENA -->
                    <LinearLayout
                        android:id="@+id/opCambiarContrasena"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="60dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackground">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Cambiar contraseña"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#111827" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Actualiza tu acceso a la biblioteca"
                                android:textSize="12sp"
                                android:textColor="#475569" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="25dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="›"
                            android:textSize="26sp"
                            android:textColor="#00562F"
                            android:gravity="center" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- BOTON CERRAR SESION -->
            <Button
                android:id="@+id/btnCerrarSesion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#006337"
                android:stateListAnimator="@null"
                android:text="Cerrar sesión"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

        </LinearLayout>

    </ScrollView>

    <!-- BARRA INFERIOR EXISTENTE -->
    <include
        android:id="@+id/barraNavegacion"
        layout="@layout/cbta_barra_navegacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
