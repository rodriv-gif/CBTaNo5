<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cbta_blanco"
    android:orientation="vertical"
    tools:context=".Vista.Libro_Recibido">

    <!-- Encabezado verde (sin título en el wireframe) -->
    <LinearLayout
        android:id="@+id/encabezado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cbta_verde_barra"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="46dp" />
    </LinearLayout>

    <!-- Contenido (esta pantalla no lleva barra de navegación) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/cbta_fondo"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="78dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/cbta_ic_exito" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/cbta_libro_titulo"
                    android:textColor="@color/cbta_verde_texto"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/texto_mensaje"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/cbta_libro_mensaje"
                    android:textColor="@color/cbta_texto"
                    android:textSize="16sp" />

            </LinearLayout>
        </ScrollView>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_aceptar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_margin="16dp"
            android:background="@drawable/cbta_bg_boton"
            android:stateListAnimator="@null"
            android:text="@string/cbta_aceptar"
            android:textAllCaps="false"
            android:textColor="@color/cbta_blanco"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>

