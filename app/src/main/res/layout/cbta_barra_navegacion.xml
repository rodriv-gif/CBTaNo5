<?xml version="1.0" encoding="utf-8"?>
<!--
    Barra de navegación inferior (Inicio, Catálogo, Reservas, Mi cuenta).
    En mis 4 pantallas ninguna pestaña va seleccionada, igual que en el wireframe.
    Si tu equipo ya tiene una barra compartida, reemplaza el <include> por la de ellos.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/barra_navegacion"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/cbta_blanco"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/cbta_borde" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:orientation="horizontal">

        <!-- Inicio -->
        <LinearLayout
            android:id="@+id/nav_inicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/cbta_ic_nav_inicio" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/cbta_nav_inicio"
                android:textColor="@color/cbta_texto_secundario"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Catálogo -->
        <LinearLayout
            android:id="@+id/nav_catalogo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/cbta_ic_nav_catalogo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/cbta_nav_catalogo"
                android:textColor="@color/cbta_texto_secundario"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Reservas -->
        <LinearLayout
            android:id="@+id/nav_reservas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/cbta_ic_calendario" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/cbta_nav_reservas"
                android:textColor="@color/cbta_texto_secundario"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Mi cuenta -->
        <LinearLayout
            android:id="@+id/nav_cuenta"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/cbta_ic_nav_cuenta" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/cbta_nav_cuenta"
                android:textColor="@color/cbta_texto_secundario"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>

