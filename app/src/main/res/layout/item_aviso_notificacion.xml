<?xml version="1.0" encoding="utf-8"?>
<!--
    Una tarjeta de aviso. El fondo, el borde y el color de la campana
    los cambia AvisosAdapter según el tipo de aviso.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tarjeta_aviso"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/cbta_bg_aviso_verde"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:id="@+id/icono_aviso"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no"
        android:src="@drawable/cbta_ic_campana" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/titulo_aviso"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/cbta_texto"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Devoluciones" />

            <TextView
                android:id="@+id/fecha_aviso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/cbta_texto_secundario"
                android:textSize="12sp"
                tools:text="Hoy" />
        </LinearLayout>

        <TextView
            android:id="@+id/mensaje_aviso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/cbta_texto"
            android:textSize="14sp"
            tools:text="Recuerde devolver sus libros en la fecha establecida." />

    </LinearLayout>

</LinearLayout>
