<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lytRaizCatalogo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cbta_blanco"
    android:orientation="vertical">

    <!-- Encabezado verde -->
    <LinearLayout
        android:id="@+id/lytEncabezadoCatalogo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:background="@color/cbta_verde_barra"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="60dp">

            <ImageButton
                android:id="@+id/btnVolverCatalogo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cbta_volver"
                android:src="@drawable/cbta_ic_volver" />

            <TextView
                android:id="@+id/txtTituloCatalogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/cbta_catalogo_titulo"
                android:textColor="@color/cbta_blanco"
                android:textSize="20sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <!-- Cuerpo principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/cbta_fondo"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp">

        <!-- Caja de búsqueda -->
        <LinearLayout
            android:id="@+id/lytBuscadorCatalogo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/cbta_bg_tarjeta"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="4dp">

            <EditText
                android:id="@+id/txtBuscarLibro"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/cbta_catalogo_buscar_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/cbta_texto"
                android:textColorHint="@color/cbta_texto_secundario"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnBuscarLibro"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cbta_catalogo_buscar_hint"
                android:src="@drawable/cbta_ic_buscar" />
        </LinearLayout>

        <!-- Barra horizontal deslizable de categorías dinámicas -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategorias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="4"
            tools:listitem="@layout/item_categoria_catalogo" />

        <!-- Lista vertical dinámica de libros -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLibros"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="12dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="4"
            tools:listitem="@layout/item_libro_catalogo" />
    </LinearLayout>

    <!-- Barra de navegación inferior compartida -->
    <include layout="@layout/cbta_barra_navegacion" />

</LinearLayout>