<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="#F4F7F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="350dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- TITULO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PRUEBAS BIBLIOTECA CBTa 5"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#004D32"
            android:gravity="center"
            android:layout_marginBottom="30dp" />

        <!-- DETALLE DEL LIBRO -->
        <Button
            android:id="@+id/btnDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Probar Detalle del libro"
            android:textAllCaps="false"
            android:backgroundTint="#006337" />

        <!-- MI CUENTA -->
        <Button
            android:id="@+id/btnCuenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="15dp"
            android:text="Probar Mi cuenta"
            android:textAllCaps="false"
            android:backgroundTint="#006337" />

        <!-- MIS PRESTAMOS -->
        <Button
            android:id="@+id/btnPrestamos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="15dp"
            android:text="Probar Mis préstamos"
            android:textAllCaps="false"
            android:backgroundTint="#006337" />

    </LinearLayout>

</ScrollView>
